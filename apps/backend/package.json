{
  "name": "astraxes-api",
  "version": "1.0.0",
  "private": true,
  "description": "Astraxes — AI Study Assistant: Cloudflare Workers API",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create astraxes-db",
    "db:init:local": "wrangler d1 execute astraxes-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute astraxes-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
